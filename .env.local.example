# Optional overrides. VynSAP generates and stores secrets automatically if omitted.
# Generate overrides with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# JWT_SECRET=
# CONNECTION_ENCRYPTION_KEY=
# Optional bootstrap admin overrides. Defaults: admin@vynsap.local / changeme.
# VYNSAP_ADMIN_EMAIL=
# VYNSAP_ADMIN_PASSWORD=

